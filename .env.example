# Copia este archivo a .env y rellena con los valores de tu proyecto de Supabase
# (Project Settings > API en el panel de Supabase). Región recomendada: Frankfurt (eu-central-1),
# para mantener los datos en la UE por RGPD.

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# La service_role key NUNCA va aquí ni en el cliente — solo se usa en Edge
# Functions, del lado del servidor.
